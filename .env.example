EXPO_PUBLIC_APP_ORIGIN=
EXPO_PUBLIC_PRIVY_APP_ID=
# Client IDs from Privy Dashboard → App clients. Do not use app secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_PRIVY_WEB_CLIENT_ID=
EXPO_PUBLIC_PRIVY_MOBILE_CLIENT_ID=
EXPO_PUBLIC_ALCHEMY_API_KEY=
EXPO_PUBLIC_CONVEX_URL=
# Key quorum ID from Privy Dashboard → Wallet infrastructure → Authorization keys
EXPO_PUBLIC_PRIVY_SIGNER_ID=
# Server only. Set on the Convex deployment (`npx convex env set`), never in EXPO_PUBLIC_*.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_AUTHORIZATION_PRIVATE_KEY=wallet-auth:...
