{
  "expo": {
    "name": "Bluebell Stock Exchange",
    "slug": "bluebell-stock-exchange",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bluebellstockexchange",
    "userInterfaceStyle": "automatic",
    "description": "Trade tokenized stocks on Base.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jacobhomanics.bluebellstockexchange"
    },
    "android": {
      "package": "com.jacobhomanics.bluebellstockexchange",
      "adaptiveIcon": {
        "backgroundColor": "#4A4FBF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Bluebell Stock Exchange",
      "shortName": "BSE",
      "themeColor": "#4A4FBF",
      "backgroundColor": "#4A4FBF",
      "description": "Trade tokenized stocks on Base."
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4A4FBF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
